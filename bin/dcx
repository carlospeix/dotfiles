#!/usr/bin/env bash
# dcx: ejecuta un comando en el devcontainer del proyecto actual.
#   dcx <cmd> [args]   ejecuta en el container (debe estar corriendo)
#   dcx --start        arranca el container existente (detenido al cerrar el IDE)
#   dcx --stop         detiene el container
# Con docker compose, --start/--stop actúan sobre todos los servicios del
# proyecto (db, etc.): el label sólo está en el servicio principal.
# Busca por label devcontainer.config_file (ruta Linux), que coincide aunque
# VS Code use executeInWSL (local_folder UNC). Nunca crea containers.
set -euo pipefail
root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
cfg="$root/.devcontainer/devcontainer.json"
[ -f "$cfg" ] || { echo "dcx: no hay $cfg" >&2; exit 2; }
filter="label=devcontainer.config_file=$cfg"

# container_id [-a]: id del único container (con -a incluye detenidos)
container_id() {
  local id
  id=$(docker ps -q ${1:-} --filter "$filter")
  [ "$(wc -w <<<"$id")" -le 1 ] || { echo "dcx: más de un container:" $id >&2; exit 4; }
  echo "$id"
}

# siblings <id> [-a]: otros containers del mismo proyecto compose (nombres)
siblings() {
  local proj
  proj=$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' "$1")
  [ -n "$proj" ] || return 0
  docker ps ${2:-} --filter "label=com.docker.compose.project=$proj" --format '{{.ID}} {{.Names}}' |
    awk -v id="$1" 'index(id, $1) != 1 && index($1, id) != 1 { print $2 }'
}

case "${1:-}" in
  --start)
    id=$(container_id -a)
    [ -n "$id" ] || { echo "dcx: no hay container creado (abrilo desde el IDE)" >&2; exit 3; }
    sibs=$(siblings "$id" -a)
    # dependencias primero, después el principal
    [ -z "$sibs" ] || docker start $sibs >/dev/null
    docker start "$id" >/dev/null
    echo "dcx: corriendo" $id $sibs
    exit ;;
  --stop)
    id=$(container_id -a)
    [ -n "$id" ] || { echo "dcx: no hay container"; exit 0; }
    run=$(docker ps -q --filter "id=$id"; siblings "$id")
    [ -n "$run" ] || { echo "dcx: ya detenido"; exit 0; }
    docker stop $run >/dev/null && echo "dcx: detenidos" $run
    exit ;;
esac

id=$(container_id)
[ -n "$id" ] || { echo "dcx: devcontainer detenido (dcx --start o abrir el IDE)" >&2; exit 3; }
all=$(siblings "$id" -a); up=$(siblings "$id")
down=$(comm -23 <(tr ' ' '\n' <<<"$all" | sort) <(tr ' ' '\n' <<<"$up" | sort) | xargs)
[ -z "$down" ] || { echo "dcx: servicios detenidos: $down (dcx --start)" >&2; exit 3; }
exec devcontainer exec --container-id "$id" --workspace-folder "$root" "$@"
